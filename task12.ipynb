  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### kmeans (2 col) - Count orders in each K-Means cluster"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 67,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.cluster import  KMeans"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 69,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Orders in each K-means Cluster: \n",
      "KMeans_Cluster\n",
      "0    76\n",
      "1    82\n",
      "2    75\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "scalar = StandardScaler()\n",
    "x_scaled = scalar.fit_transform(X)\n",
    "\n",
    "kmeans = KMeans(n_clusters= 3, random_state= 42, n_init= 10)\n",
    "\n",
    "kmeans_labels = kmeans.fit_predict(x_scaled)\n",
    "\n",
    "results = X.copy()\n",
    "results[\"KMeans_Cluster\"] = kmeans_labels\n",
    "\n",
    "print(\"Orders in each K-means Cluster: \")\n",
    "print(results[\"KMeans_Cluster\"].value_counts().sort_index())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 70,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# visualize clusters\n",
    "plt.figure(figsize=(8,5))\n",
    "sns.scatterplot(data= results, x= feature_col[0] , y= feature_col[1], hue= \"KMeans_Cluster\", palette= \"viridis\", s= 60)\n",
    "\n",
    "plt.title(\"K-Means Clustering (k= 3)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Elbow and Inertia"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 72,
   "metadata": {},
   "outputs": [],
   "source": [
    "inertias = []\n",
    "k_values = range(1,11)\n",
    "\n",
    "for k in k_values:\n",
    "    model = KMeans(n_clusters= k, random_state= 42, n_init= 10)\n",
    "    model.fit(x_scaled)\n",
    "    inertias.append(model.inertia_)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 79,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(k_values, inertias, marker=\"o\")\n",
    "\n",
    "plt.xlabel(\"Number of Clusters (k)\")\n",
    "plt.ylabel(\"Inertia\")\n",
    "\n",
    "plt.title(\"Elbow Method\")\n",
    "plt.xticks(list(k_values))\n",
    "\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### DBSCAN - Count of core point,border and noise"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 80,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.cluster import  DBSCAN"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 91,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DBSCAN Cluster Counts: \n",
      "DBSCAN_Cluster\n",
      "-1    11\n",
      " 0    75\n",
      " 1    74\n",
      " 2    73\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "dbscan = DBSCAN(eps= 0.3, min_samples= 5)\n",
    "\n",
    "dbscan_labels = dbscan.fit_predict(x_scaled)\n",
    "\n",
    "results[\"DBSCAN_Cluster\"] = dbscan_labels\n",
    "\n",
    "print(\"DBSCAN Cluster Counts: \")\n",
    "print(results[\"DBSCAN_Cluster\"].value_counts().sort_index())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 92,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Visualize DBSCAN Clusters\n",
    "plt.figure(figsize= (8,5))\n",
    "sns.scatterplot(data= results, x= feature_col[0], y= feature_col[1], hue= \"DBSCAN_Cluster\", palette= \"tab10\")\n",
    "\n",
    "plt.title(\"DBSCAN Clustering\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 94,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Core Points:  215\n",
      "Border Points:  7\n",
      "Noise Points:  11\n",
      "\n",
      "Total Points:  233\n",
      "Check:  233\n"
     ]
    }
   ],
   "source": [
    "labels = dbscan.labels_\n",
    "\n",
    "core_indices = dbscan.core_sample_indices_\n",
    "n_core = len(core_indices)\n",
    "\n",
    "n_noise = np.sum(labels == -1)\n",
    "\n",
    "n_border = np.sum(labels != -1) - n_core\n",
    "\n",
    "print(\"Core Points: \" , n_core)\n",
    "print(\"Border Points: \" , n_border)\n",
    "print(\"Noise Points: \" , n_noise)\n",
    "\n",
    "print(\"\\nTotal Points: \" , len(labels))\n",
    "print(\"Check: \" , n_core + n_border + n_noise)"
   ]
  },
  {
