   ],
   "source": [
    "eps_values = [0.3, 0.5, 0.7]\n",
    "min_samples_values = [3, 5]\n",
    "\n",
    "experiments = []\n",
    "\n",
    "for eps in eps_values:\n",
    "    for min_sample in min_samples_values:\n",
    "        model = DBSCAN(eps= eps, min_samples= min_sample)\n",
    "\n",
    "        labels = model.fit_predict(x_scaled)\n",
    "\n",
    "        core_count = len(model.core_sample_indices_)\n",
    "        noise_count = np.sum(labels == -1)\n",
    "        border_count = np.sum(labels != -1) - core_count\n",
    "\n",
    "        n_clusters = len(set(labels) - {-1})\n",
    "\n",
    "        experiments.append({\"eps\" : eps, \n",
    "                            \"min_samples\" : min_sample,\n",
    "                            \"n_clusters\" : n_clusters,\n",
    "                            \"core_points\" : core_count,\n",
    "                            \"border_points\" : border_count,\n",
    "                            \"noise_points\" : noise_count})\n",
    "\n",
    "experiments_df = pd.DataFrame(experiments)\n",
    "display(experiments_df)"
   ]
  },
